# Read by `docker compose` (variable substitution into docker-compose.yml) and by
# `node --env-file=.env build`. The app itself does not load this file.
# All variables: docs/DEPLOYMENT.md#environment-variables

# Database file and attachments folder (use absolute paths in production)
DATABASE_URL=./data/crumbs.db
# DATA_DIR=./data

# Public URL exactly as typed in the browser, no trailing slash
# (CSRF check, OAuth callbacks, email links)
ORIGIN=http://localhost:3000

# Largest request body; must exceed the 10 MB attachment limit (Docker image default: 12M)
# BODY_SIZE_LIMIT=12M

# Behind a reverse proxy: read the client IP from X-Forwarded-For
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# --- OAuth Providers (optional, auto-enabled when set) ---

# Google OAuth 2.0
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# Generic OIDC (e.g. Authentik, Keycloak, Okta)
# AUTH_OIDC_ISSUER=https://your-idp.example.com
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_DISPLAY_NAME=SSO

# --- Email Notifications (optional, auto-enabled when SMTP_HOST is set) ---

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Crumbs <noreply@example.com>
